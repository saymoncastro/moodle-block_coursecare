{{!
    @template block_coursecare/overview_categories

    "Where the files are" section of the overview page: the four categories of the course with their
    explanation, size and share (FR-012). Students' files appear only here, for the whole course.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * categories - object with "heading" and "rows" (see block_coursecare/overview_item)

    Example context (json):
    {
        "categories": {
            "heading": "Where the files are",
            "rows": [
                {"name": "Course materials", "help": "Files you and other editors published.", "hasurl": false,
                 "size": "4.0 MB", "share": "60%", "width": 60}
            ]
        }
    }
}}
{{#categories}}
<section class="block_coursecare-overview-section card">
    <div class="card-body">
        <h3 class="block_coursecare-overview-sectiontitle">{{heading}}</h3>
        <ul class="block_coursecare-overview-list list-unstyled mb-0">
            {{#rows}}
            <li>{{> block_coursecare/overview_item }}</li>
            {{/rows}}
        </ul>
    </div>
</section>
{{/categories}}
