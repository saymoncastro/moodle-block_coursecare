{{!
    @template block_coursecare/overview

    The "Your course in numbers" page of the CourseCare block (Feature 003, contracts/overview-page.md).
    Every sentence comes already translated from the course_overview renderable; this template only lays
    them out: the way back, the opening with the volume of the course, then where the files are and the
    large files side by side on wide screens, the materials by activity and the technical details.
    Sections without data are left out (states A, B, C and G).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title, intro, backurl, backtext - page title, introduction and the way back to the course
    * hero - the opening, see block_coursecare/overview_summary
    * hascategories, categories - see block_coursecare/overview_categories
    * hasactivities, activities - see block_coursecare/overview_activities
    * haslarge, large - see block_coursecare/overview_large
    * hastechnical, technical - see block_coursecare/overview_technical

    Example context (json):
    {
        "title": "Your course in numbers",
        "intro": "See where the files of your course are and when they were measured.",
        "backurl": "https://example.com/course/view.php?id=2",
        "backtext": "Back to the course",
        "hero": {
            "hasvolume": true,
            "volumelabel": "Files in this course, as recorded by Moodle",
            "volume": "6.0 MB",
            "sentences": [],
            "date": "Calculated on 16/10/26, 10:12.",
            "notes": [],
            "coverage": ""
        },
        "hascategories": false,
        "hasactivities": false,
        "haslarge": false,
        "hastechnical": false
    }
}}
<div class="block_coursecare-overview">
    <p class="block_coursecare-overview-back"><a href="{{backurl}}">{{backtext}}</a></p>
    {{> block_coursecare/overview_summary }}
    {{#hascategories}}
    <div class="block_coursecare-overview-grid">
        {{> block_coursecare/overview_categories }}
        {{#haslarge}}
        {{> block_coursecare/overview_large }}
        {{/haslarge}}
    </div>
    {{/hascategories}}
    {{#hasactivities}}
    {{> block_coursecare/overview_activities }}
    {{/hasactivities}}
    {{#hastechnical}}
    {{> block_coursecare/overview_technical }}
    {{/hastechnical}}
</div>
