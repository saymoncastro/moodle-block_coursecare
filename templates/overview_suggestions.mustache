{{!
    @template block_coursecare/overview_suggestions

    "Suggestions for your course" section of the overview page (Feature 004, contracts/suggestions-ui.md): the
    suggestion about large course materials in three labelled parts (what was noticed, why it may deserve
    attention, what the teacher can do if they wish), or one neutral sentence when no suggestion applies. On wide
    screens the facts (a tinted panel) and the reason and options sit side by side; on small screens they stack,
    facts first. Activity names (format_string()) and the observed sentence (numbers emphasised) are already safe
    HTML and are printed as is.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * suggestions - object with heading, hassuggestion and none; with a suggestion also basedon, title,
      observedlabel, whylabel, todolabel, observed, hasplaces, places (name, hasurl, url, size), more,
      truncated, why, todo and options (objects with "text" and "example")

    Example context (json):
    {
        "suggestions": {
            "heading": "Suggestions for your course",
            "hassuggestion": true,
            "none": "",
            "basedon": "These suggestions use the analysis of 17/10/26, 19:21.",
            "title": "Large materials",
            "observedlabel": "What we noticed",
            "whylabel": "Why it may deserve attention",
            "todolabel": "What you can do, if you wish",
            "observed": "<strong>2</strong> course materials of 1.0 MB or more, <strong>3.9 MB</strong> in total, in:",
            "hasplaces": true,
            "places": [
                {"name": "Lesson 1", "hasurl": true, "url": "https://example.com/mod/resource/view.php?id=7",
                 "size": "2.3 MB"}
            ],
            "more": "",
            "truncated": "",
            "why": "Large files can take longer to open, especially on slow connections or on a phone.",
            "todo": "When you review the activity, consider whether any of these options suits your material.",
            "options": [{"text": "splitting long content into shorter parts;", "example": ""}]
        }
    }
}}
{{#suggestions}}
<section id="block_coursecare-suggestions" class="block_coursecare-overview-section block_coursecare-overview-suggestions">
    <h3 class="block_coursecare-overview-sectiontitle">{{heading}}</h3>
    {{#hassuggestion}}
    <p class="block_coursecare-overview-help">{{basedon}}</p>
    <div class="block_coursecare-overview-suggestion">
        <h4 class="block_coursecare-overview-suggestiontitle">{{title}}</h4>
        <div class="block_coursecare-overview-suggestionparts">
            <dl class="block_coursecare-overview-suggestionfacts mb-0">
                <dt>{{observedlabel}}</dt>
                <dd>
                    <p class="mb-2">{{{observed}}}</p>
                    {{#hasplaces}}
                    <ul class="block_coursecare-overview-places list-unstyled">
                        {{#places}}
                        <li>
                            <span class="block_coursecare-overview-placename">{{#hasurl}}<a href="{{url}}">{{{name}}}</a>{{/hasurl}}{{^hasurl}}{{{name}}}{{/hasurl}}</span>
                            <span class="block_coursecare-overview-placesize">{{size}}</span>
                        </li>
                        {{/places}}
                    </ul>
                    {{/hasplaces}}
                    {{#more}}
                    <p class="mb-0">{{more}}</p>
                    {{/more}}
                    {{#truncated}}
                    <p class="block_coursecare-overview-help mt-1 mb-0">{{truncated}}</p>
                    {{/truncated}}
                </dd>
            </dl>
            <dl class="block_coursecare-overview-suggestionadvice mb-0">
                <dt>{{whylabel}}</dt>
                <dd><p class="mb-0">{{why}}</p></dd>
                <dt>{{todolabel}}</dt>
                <dd class="mb-0">
                    <p class="mb-2">{{todo}}</p>
                    <ul class="block_coursecare-overview-options mb-0">
                        {{#options}}
                        <li>{{text}}{{#example}}<span class="block_coursecare-overview-optionexample">{{example}}</span>{{/example}}</li>
                        {{/options}}
                    </ul>
                </dd>
            </dl>
        </div>
    </div>
    {{/hassuggestion}}
    {{^hassuggestion}}
    <p class="mb-0">{{none}}</p>
    {{/hassuggestion}}
</section>
{{/suggestions}}
