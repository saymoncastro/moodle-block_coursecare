{{!
    @template block_coursecare/overview_potential

    "Potential of assignments" section of the overview page (Feature 005): what the current settings of each
    assignment with file submissions allow, in the order of the course, with what the potential means and, in a
    collapsed part, how it is calculated and its limits. No total and no ranking.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * potential - object with heading, intro, meaning, scope, recorded, hasitems, items (name, url, hasurl, hidden,
      factors, result and guidance), none, howtitle and how; guidance (Feature 009, optional, collapsed): id, title,
      meaning, implications, notes, stepstitle, steps, settingsurl, settingstext, questionstitle, questions and novalue

    Example context (json):
    {
        "potential": {
            "heading": "Potential of assignments",
            "intro": "What the current settings of the assignments allow to be stored in submitted files.",
            "meaning": "The theoretical potential is a ceiling set by the settings.",
            "scope": "This section covers assignments only.",
            "recorded": "In this course, files already submitted in activities add up to 120.0 MB.",
            "hasitems": true,
            "items": [
                {"name": "Lab report", "hasurl": true, "url": "https://example.com/mod/assign/view.php?id=7",
                 "hidden": "",
                 "factors": [{"text": "Up to 3 files per participant, of up to 10.0 MB each."},
                    {"text": "1 attempt."}, {"text": "30 participants can submit."}],
                 "result": "Theoretical potential: 900.0 MB (30 × 3 × 10.0 MB)."}
            ],
            "none": "",
            "howtitle": "How the potential is calculated, and its limits",
            "how": [{"text": "Due dates and access restrictions are not considered."}]
        }
    }
}}
{{#potential}}
<section id="block_coursecare-potential" class="block_coursecare-overview-section block_coursecare-overview-potential">
    <h3 class="block_coursecare-overview-sectiontitle">{{heading}}</h3>
    <p class="mb-1">{{intro}}</p>
    <p class="mb-1">{{meaning}}</p>
    <p class="block_coursecare-overview-help">{{scope}}</p>
    {{#recorded}}
    <p class="block_coursecare-overview-help">{{recorded}}</p>
    {{/recorded}}
    {{#hasitems}}
    <ul class="block_coursecare-overview-potentiallist list-unstyled">
        {{#items}}
        <li class="block_coursecare-overview-potentialitem">
            <h4 class="block_coursecare-overview-potentialname">{{#hasurl}}<a href="{{url}}">{{{name}}}</a>{{/hasurl}}{{^hasurl}}{{{name}}}{{/hasurl}}</h4>
            {{#hidden}}
            <p class="block_coursecare-overview-help mb-1">{{hidden}}</p>
            {{/hidden}}
            {{#factors}}
            <p class="mb-1">{{text}}</p>
            {{/factors}}
            <p class="block_coursecare-overview-potentialresult mb-0">{{result}}</p>
            {{#guidance}}
            <details class="block_coursecare-overview-guidance" id="{{id}}">
                <summary>{{title}}</summary>
                <div class="block_coursecare-overview-guidancebody">
                    <p class="mb-2">{{meaning}}</p>
                    <ul class="mb-2">
                        {{#implications}}
                        <li>{{text}}</li>
                        {{/implications}}
                    </ul>
                    {{#notes}}
                    <p class="mb-2">{{text}}</p>
                    {{/notes}}
                    <h5 class="block_coursecare-overview-guidancetitle">{{stepstitle}}</h5>
                    <ol class="mb-2">
                        {{#steps}}
                        <li>{{text}}</li>
                        {{/steps}}
                    </ol>
                    {{#settingsurl}}
                    <p class="mb-2"><a class="btn btn-outline-primary btn-sm" href="{{settingsurl}}">{{settingstext}}</a></p>
                    {{/settingsurl}}
                    <h5 class="block_coursecare-overview-guidancetitle">{{questionstitle}}</h5>
                    <ul class="mb-2">
                        {{#questions}}
                        <li>{{text}}</li>
                        {{/questions}}
                    </ul>
                    <p class="block_coursecare-overview-help mb-0">{{novalue}}</p>
                </div>
            </details>
            {{/guidance}}
        </li>
        {{/items}}
    </ul>
    {{/hasitems}}
    {{#none}}
    <p>{{none}}</p>
    {{/none}}
    <details class="block_coursecare-overview-potentialhow">
        <summary>{{howtitle}}</summary>
        <ul class="mb-0">
            {{#how}}
            <li>{{text}}</li>
            {{/how}}
        </ul>
    </details>
</section>
{{/potential}}
