{{!
    @template block_coursecare/overview_history

    "How the files of your course have changed" section of the overview page (Feature 006): the latest measurement,
    one neutral sentence about the change since the previous one, the chart of the recorded files by day and,
    collapsed, a table with every measurement and its categories, then the limits of the history.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * history - object with heading, intro, meaning, latest, change, haschart, chart (HTML of the core chart),
      datatitle, columns (name), rows (date, partial, cells with value), limitstitle and limits (text)

    Example context (json):
    {
        "history": {
            "heading": "How the files of your course have changed",
            "intro": "Each value is a measurement of the files recorded in Moodle for this course.",
            "meaning": "An increase or a decrease, on its own, does not mean a problem or an improvement.",
            "latest": "Latest measurement: 18/10/26, 09:00.",
            "change": "The files recorded in this course decreased by 10.0 MB since the analysis of 17 October 2026.",
            "haschart": false,
            "chart": "",
            "datatitle": "Measurements and categories",
            "columns": [{"name": "Date"}, {"name": "Files recorded"}],
            "rows": [
                {"date": "18 October 2026", "partial": "", "cells": [{"value": "140.0 MB"}]}
            ],
            "limitstitle": "About these measurements",
            "limits": [{"text": "Days without an analysis have no value; nothing is estimated for them."}]
        }
    }
}}
{{#history}}
<section id="block_coursecare-history" class="block_coursecare-overview-section block_coursecare-overview-history">
    <h3 class="block_coursecare-overview-sectiontitle">{{heading}}</h3>
    <p class="mb-1">{{intro}}</p>
    <p class="block_coursecare-overview-help">{{meaning}}</p>
    <p class="mb-1">{{latest}}</p>
    <p class="block_coursecare-overview-historychange">{{change}}</p>
    {{#haschart}}
    <div class="block_coursecare-overview-historychart">
        {{{chart}}}
    </div>
    {{/haschart}}
    <details class="block_coursecare-overview-historydata">
        <summary>{{datatitle}}</summary>
        <div class="block_coursecare-overview-historytable" tabindex="0" role="region" aria-label="{{datatitle}}">
            <table class="table table-sm mb-2">
                <caption class="visually-hidden">{{datatitle}}</caption>
                <thead>
                    <tr>
                        {{#columns}}
                        <th scope="col">{{name}}</th>
                        {{/columns}}
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <th scope="row">{{date}}{{#partial}}<br><small>{{partial}}</small>{{/partial}}</th>
                        {{#cells}}
                        <td>{{value}}</td>
                        {{/cells}}
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
        <h4 class="block_coursecare-overview-subtitle">{{limitstitle}}</h4>
        <ul class="mb-0">
            {{#limits}}
            <li>{{text}}</li>
            {{/limits}}
        </ul>
    </details>
</section>
{{/history}}
