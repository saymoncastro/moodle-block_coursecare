{{!
    @template block_coursecare/overview_activities

    "Materials by activity" section of the overview page: only the materials of each activity (FR-013,
    FR-030), the first ones, the groups without names, and the rest behind "Show all" (FR-014).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * activities - object with heading, help, first, groups, hasrest, rest and showall; rows as in
      block_coursecare/overview_item

    Example context (json):
    {
        "activities": {
            "heading": "Materials by activity",
            "help": "Only the materials of each activity are shown here.",
            "first": [
                {"name": "Reading 1", "hasurl": true, "url": "https://example.com/mod/resource/view.php?id=7",
                 "size": "2.0 MB", "share": "50%", "width": 50}
            ],
            "groups": [
                {"name": "Course page, sections and blocks", "hasurl": false, "size": "1.0 MB", "share": "25%",
                 "width": 25}
            ],
            "hasrest": true,
            "rest": [
                {"name": "Reading 2", "hasurl": true, "url": "https://example.com/mod/resource/view.php?id=8",
                 "size": "1.0 MB", "share": "25%", "width": 25}
            ],
            "showall": "Show all activities (2)"
        }
    }
}}
{{#activities}}
<section class="block_coursecare-overview-section card">
    <div class="card-body">
        <h3 class="block_coursecare-overview-sectiontitle">{{heading}}</h3>
        <p class="block_coursecare-overview-help">{{help}}</p>
        <ul class="block_coursecare-overview-list list-unstyled">
            {{#first}}
            {{> block_coursecare/overview_item }}
            {{/first}}
            {{#groups}}
            {{> block_coursecare/overview_item }}
            {{/groups}}
        </ul>
        {{#hasrest}}
        <details class="block_coursecare-overview-more">
            <summary>{{showall}}</summary>
            <ul class="block_coursecare-overview-list list-unstyled mb-0">
                {{#rest}}
                {{> block_coursecare/overview_item }}
                {{/rest}}
            </ul>
        </details>
        {{/hasrest}}
    </div>
</section>
{{/activities}}
