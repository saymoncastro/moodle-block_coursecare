{{!
    @template block_coursecare/content

    Initial educational content of the CourseCare block: a decorative icon, the identity
    sentence and the message announcing upcoming guidance. It shows no indicators.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {}
}}
<div class="block_coursecare-content">
    <div class="block_coursecare-illustration">{{#pix}} sprout, block_coursecare {{/pix}}</div>
    <div class="block_coursecare-text">
        <p class="block_coursecare-tagline">{{#str}} tagline, block_coursecare {{/str}}</p>
        <p class="block_coursecare-intro mb-0">{{#str}} intro, block_coursecare {{/str}}</p>
    </div>
</div>
