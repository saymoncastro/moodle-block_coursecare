{{!
    @template block_coursecare/overview_summary

    Summary of the overview page: the identity, the title, the state of the diagnostic with its date, and
    the way back to the course.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title, intro, backurl, backtext
    * summary - list of objects with "text"

    Example context (json):
    {
        "title": "Your course in numbers",
        "intro": "Get to know the files of your course: where they are and when they were measured.",
        "backurl": "https://example.com/course/view.php?id=2",
        "backtext": "Back to the course",
        "summary": [
            {"text": "The file overview for this course is not available yet."}
        ]
    }
}}
<section class="block_coursecare-overview-section block_coursecare-overview-summary card">
    <div class="card-body">
        <div class="block_coursecare-overview-heading">
            <span class="block_coursecare-overview-illustration">{{#pix}} sprout, block_coursecare {{/pix}}</span>
            <h2 class="block_coursecare-overview-title">{{title}}</h2>
        </div>
        <p class="block_coursecare-overview-intro">{{intro}}</p>
        <div class="block_coursecare-overview-state">
            {{#summary}}
            <p>{{text}}</p>
            {{/summary}}
        </div>
        <p class="block_coursecare-overview-back mb-0"><a href="{{backurl}}">{{backtext}}</a></p>
    </div>
</section>
